rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && userDoc().data.active == true;
    }

    function isAdmin() {
      return activeUser() && userDoc().data.role == 'admin';
    }

    function sameOrganization(organizationId) {
      return activeUser() && userDoc().data.organizationId == organizationId;
    }

    function unchangedRole() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.active == true
        && request.resource.data.organizationId is string;
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && unchangedRole()
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.email == resource.data.email)
        || isAdmin()
      );
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /organizations/{organizationId} {
      allow read: if sameOrganization(organizationId);
      allow create, update: if isAdmin() && sameOrganization(organizationId);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if activeUser() && resource.data.recipientUid == request.auth.uid;
      allow update: if activeUser()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'status']);
      allow create, delete: if false;
    }

    match /audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
