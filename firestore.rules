rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cobertura de colecciones ──
    // Cada colección que el código realmente usa (grep de .collection('...')
    // en todos los .js, incluida la lista dinámica del respaldo en
    // rutas-repartidores.js) tiene su propio bloque `match` más abajo, con
    // reglas explícitas de read/create/update/delete. Ninguna depende del
    // catch-all final para funcionar — ese catch-all solo existe para
    // bloquear colecciones NO anticipadas (typos, nombres nuevos que se
    // agreguen en el código sin agregar su regla aquí).
    //   ✅ productos            ✅ barcodes            ✅ notas
    //   ✅ pedidos             ✅ inventario_historial ✅ creditos
    //   ✅ rutas
    //   ✅ clientes             ✅ devoluciones       ✅ gastos
    //   ✅ cierres_caja         ✅ usuarios           ✅ _meta
    //   ✅ vehiculos/medidores  ✅ jornadas y subcolecciones
    //   ✅ rutas_catalogo        ✅ tarifas_agua
    // Si agregas una colección nueva en el código: agrégala aquí también, o
    // sus lecturas/escrituras van a fallar en silencio (ya nos ocurrió con
    // una colección operativa sin regla explícita).

    // ── Helpers ──
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && role() == 'admin';
    }
    function isVendedor() {
      // usuario se conserva únicamente como alias heredado de vendedor.
      return signedIn() && (role() == 'vendedor' || role() == 'usuario');
    }
    function isRepartidor() {
      return signedIn() && role() == 'repartidor';
    }
    function puedeOperarMedidor() {
      return isAdmin() || isVendedor() || isRepartidor();
    }
    function puedeUsarCaja() {
      return isAdmin() || isVendedor() || isRepartidor();
    }
    function puedeCobrarCredito(data) {
      return isAdmin()
        || isVendedor()
        || (isRepartidor() && signedIn() && ((data.cobradorUids is list && request.auth.uid in data.cobradorUids)
          || data.capturadoPorUid == request.auth.uid));
    }
    function jornadaPropia(data) {
      return isAdmin()
        || (isRepartidor() && data.repartidorId == request.auth.uid)
        || (isVendedor() && data.operadorUid == request.auth.uid);
    }
    function jornadaVisible(vehiculoId, jornadaId) {
      return isAdmin()
        || jornadaPropia(get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data);
    }
    function cajaPropia(data) {
      return (isRepartidor() && data.repartidorId == request.auth.uid)
        || (isVendedor() && data.operadorUid == request.auth.uid);
    }
    function brandingValida(data) {
      return data.nombreComercial is string
        && data.nombreComercial.size() > 0
        && data.nombreComercial.size() <= 80
        && data.subtitulo is string
        && data.subtitulo.size() <= 100
        && data.lema is string
        && data.lema.size() <= 120
        && data.telefono is string
        && data.telefono.size() <= 30
        && data.logoPath == 'icons/icon-192.png';
    }
    function setupProyectoValido(data) {
      return data.firebaseProjectId is string
        && data.firebaseProjectId.size() > 0
        && data.nombreEmpresa is string
        && data.nombreEmpresa.size() > 0
        && data.nombreEmpresa.size() <= 100
        && data.tipoFlujoMedidor is string
        && data.unidadMedidorPredeterminada is string
        && data.cantidadPorDigitoPredeterminada is number
        && data.cantidadPorDigitoPredeterminada > 0
        && data.telefonoEmpresa is string
        && data.telefonoEmpresa.size() <= 30
        && data.whatsappModo == 'wa.me'
        && data.administradoresIniciales is list
        && data.administradoresIniciales.size() > 0
        && data.administradoresIniciales.size() <= 20
        && data.configuracionInicialCompletada == true;
    }
    function medidorConfigValida(data) {
      return data.tipoFlujoMedidor is string
        && data.unidadMedida is string
        && data.cantidadPorDigito is number
        && data.cantidadPorDigito > 0
        && data.preciosMedidor is list
        && data.preciosMedidor.size() <= 5;
    }
    function precioMedidorValido(data) {
      return data.nombre is string
        && data.nombre.size() > 0
        && data.precioPorUnidad is number
        && data.precioPorUnidad > 0
        && data.unidadMedida is string;
    }
    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Refleja los permisos concedidos desde Configuración → Permisos (permisos.js)
    // en la app: cada usuario puede tener overrides en usuarios/{uid}.permisos.edita
    // que se combinan sobre el valor por defecto de su rol (mismo criterio que
    // permisoEdita() en app-core.js — si se cambia uno, cambiar el otro).
    // 'recurso' es uno de: 'productos', 'clientes', 'creditos'.
    // El permiso de productos no concede al repartidor ajustes manuales; su
    // única excepción está declarada en match /productos/{id} y se valida con
    // el documento de la transferencia creada en la misma transacción.
    function permisoEdicion(recurso) {
      let datos = datosUsuario();
      let overrides = ('permisos' in datos) && ('edita' in datos.permisos) ? datos.permisos.edita : {};
      let porDefecto = ((datos.role == 'vendedor' || datos.role == 'usuario')
          && recurso == 'creditos')
        || (datos.role == 'repartidor'
          && (recurso == 'clientes' || recurso == 'creditos'));
      let valor = recurso in overrides ? overrides[recurso] == true : porDefecto;
      // El repartidor nunca obtiene edición manual de productos, aunque exista
      // un override antiguo en usuarios/{uid}.permisos.edita.
      return signedIn()
        && !(recurso == 'productos' && datos.role == 'repartidor')
        && (datos.role == 'admin' || valor);
    }

    // Comprueba que la reserva en barcodes/{codigo} apunte al mismo producto.
    // Se usa getAfter/existsAfter para exigir una escritura atómica.
    function indiceCodigoProductoValido(data, productoId) {
      return !('codigoBarrasNormalizado' in data)
        || data.codigoBarrasNormalizado == ''
        || (data.codigoBarrasNormalizado is string
          && existsAfter(/databases/$(database)/documents/barcodes/$(data.codigoBarrasNormalizado))
          && getAfter(/databases/$(database)/documents/barcodes/$(data.codigoBarrasNormalizado)).data.productoId == productoId
          && getAfter(/databases/$(database)/documents/barcodes/$(data.codigoBarrasNormalizado)).data.codigo == data.codigoBarrasNormalizado);
    }

    // ── productos ──
    match /productos/{id} {
      allow read: if signedIn();
      allow create: if permisoEdicion('productos')
        && indiceCodigoProductoValido(request.resource.data, id);
      // Admin ajusta inventario. El repartidor descuenta stock únicamente al
      // crear una transferencia atómica; vendedor descuenta solo el SKU incluido
      // en su ticket público de planta y deja una referencia inmutable de venta.
      allow update: if (permisoEdicion('productos')
          && indiceCodigoProductoValido(request.resource.data, id))
        || (isRepartidor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock', 'ultimaTransferenciaId',
            'ultimaTransferenciaRepartidorUid',
            'ultimaTransferenciaCantidad', 'ultimaTransferenciaFecha'
          ])
          && request.resource.data.ultimaTransferenciaRepartidorUid == request.auth.uid
          && request.resource.data.ultimaTransferenciaId is string
          && request.resource.data.ultimaTransferenciaCantidad > 0
          && request.resource.data.stock
            == resource.data.stock - request.resource.data.ultimaTransferenciaCantidad
          && !exists(/databases/$(database)/documents/rutas/$(request.resource.data.ultimaTransferenciaId))
          && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.ultimaTransferenciaId)).data.repartidorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.ultimaTransferenciaId)).data.estado == 'activa'
          && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.ultimaTransferenciaId)).data.items.keys().hasAny([id])
          && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.ultimaTransferenciaId)).data.items[id].cantCargada == request.resource.data.ultimaTransferenciaCantidad)
        || (isVendedor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock', 'ultimaVentaPublicaId', 'ultimaVentaPublicaVendedorUid',
            'ultimaVentaPublicaProductoId', 'ultimaVentaPublicaCantidad'
          ])
          && request.resource.data.ultimaVentaPublicaVendedorUid == request.auth.uid
          && request.resource.data.ultimaVentaPublicaProductoId == id
          && request.resource.data.ultimaVentaPublicaProductoId is string
          && request.resource.data.ultimaVentaPublicaCantidad is number
          && request.resource.data.ultimaVentaPublicaCantidad > 0
          && request.resource.data.stock == resource.data.stock - request.resource.data.ultimaVentaPublicaCantidad
          && request.resource.data.ultimaVentaPublicaId is string
          && getAfter(/databases/$(database)/documents/notas/$(request.resource.data.ultimaVentaPublicaId)).data.capturadoPorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/notas/$(request.resource.data.ultimaVentaPublicaId)).data.origen == 'planta_publico_general'
          && getAfter(/databases/$(database)/documents/notas/$(request.resource.data.ultimaVentaPublicaId)).data.productoIds.hasAny([id]))
        || (isVendedor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock', 'actualizadoEn', 'ultimaProduccionId', 'ultimaProduccionTipo',
            'ultimaProduccionCantidad', 'ultimaProduccionVendedorUid'
          ])
          && request.resource.data.ultimaProduccionVendedorUid == request.auth.uid
          && request.resource.data.ultimaProduccionId is string
          && request.resource.data.ultimaProduccionTipo in ['entrada', 'salida']
          && request.resource.data.ultimaProduccionCantidad is number
          && request.resource.data.ultimaProduccionCantidad > 0
          && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.ultimaProduccionId)).data.tipo == 'llenado_produccion'
          && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.ultimaProduccionId)).data.capturadoPorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.ultimaProduccionId)).data.productoIds.hasAny([id])
          && ((request.resource.data.ultimaProduccionTipo == 'salida'
            && request.resource.data.stock == resource.data.stock - request.resource.data.ultimaProduccionCantidad)
            || (request.resource.data.ultimaProduccionTipo == 'entrada'
            && request.resource.data.stock == resource.data.stock + request.resource.data.ultimaProduccionCantidad)));
      allow delete: if isAdmin();
    }

    // Índice de unicidad y resolución rápida del código. No se permite
    // modificarlo de forma independiente: siempre debe apuntar a un producto.
    match /barcodes/{codigo} {
      allow read: if signedIn();
      allow create, update: if permisoEdicion('productos')
        && request.resource.data.productoId is string
        && request.resource.data.codigo == codigo
        && request.resource.data.activo == true
        && getAfter(/databases/$(database)/documents/productos/$(request.resource.data.productoId)).data.codigoBarrasNormalizado == codigo;
      allow delete: if permisoEdicion('productos')
        && resource.data.productoId is string
        && get(/databases/$(database)/documents/productos/$(resource.data.productoId)).data.codigoBarrasNormalizado == codigo;
    }

    // ── inventario_historial ──
    // Solo admin lee. Cualquiera autenticado puede crear su propio registro
    // (usuarioUid debe coincidir con quien está autenticado) — la escritura
    // real de stock que acompaña a este log ya está protegida por su propia
    // regla (productos: permisoEdicion), así que aquí basta con el ownership.
    // Los registros de ajuste pertenecen a almacén; el repartidor solo
    // descuenta stock mediante la excepción transaccional de productos.
    match /inventario_historial/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.usuarioUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── clientes ──
    match /clientes/{id} {
      // Catálogo general: todos los roles autenticados pueden localizar clientes.
      // La cartera del repartidor solo cambia el orden/prioridad en la interfaz.
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isRepartidor()
          && request.resource.data.creadoPorUid == request.auth.uid
          && request.resource.data.repartidorIds is list
          && request.resource.data.rutaId is string
          && (
            (request.resource.data.rutaId == '' && request.resource.data.repartidorIds.size() == 0)
            || (request.auth.uid in request.resource.data.repartidorIds
              && get(/databases/$(database)/documents/rutas_catalogo/$(request.resource.data.rutaId)).data.repartidorId == request.auth.uid)
          ))
        || (isVendedor()
          && id == 'publico_general'
          && request.resource.data.nombre == 'Público general'
          && request.resource.data.telefono is string
          && request.resource.data.domicilio is string
          && request.resource.data.activo == true
          && request.resource.data.esPublicoGeneral == true
          && request.resource.data.ambito == 'planta'
          && request.resource.data.creadoPorUid == request.auth.uid);
      allow update: if isAdmin()
        || (isRepartidor()
          && resource.data.asignacionEstado == 'disponible'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asignacionEstado', 'repartidorId', 'repartidorIds', 'rutaId', 'rutaIds'])
          && request.resource.data.asignacionEstado == 'asignado'
          && request.resource.data.repartidorId == request.auth.uid
          && request.resource.data.repartidorIds.hasOnly([request.auth.uid]));
      allow delete: if false;
    }

    // ── notas (ventas) ──
    // Son inmutables. Las ventas actuales de reparto se validan contra una
    // jornada activa y su medidor; las transferencias solo cubren el flujo
    // histórico de mercancía física.
    match /notas/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.capturadoPorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.capturadoPorUid == request.auth.uid
        && (
          (request.resource.data.origen == 'almacen' && permisoEdicion('productos'))
          || (request.resource.data.origen == 'planta_publico_general'
            && (isVendedor() || isAdmin())
            && request.resource.data.tipoVenta == 'planta_publico_general'
            && request.resource.data.medioOperacion == 'planta'
            && request.resource.data.responsableTipo == 'vendedor'
            && request.resource.data.clienteId == 'publico_general'
            && request.resource.data.formaPago != 'credito'
            && request.resource.data.unidadOperativaId is string
            && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.tipoUnidad == 'planta'
            && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.operadorUid == request.auth.uid)
            && request.resource.data.productoIds is list
            && request.resource.data.productoIds.size() > 0)
          || ((request.resource.data.origen == 'transferencia_almacen' || request.resource.data.origen == 'qr_cliente_ruta')
            && request.resource.data.transferenciaId is string
            && request.resource.data.rutaId == request.resource.data.transferenciaId
            && (isAdmin() || getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.transferenciaId)).data.repartidorId == request.auth.uid)
            && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.transferenciaId)).data.estado == 'activa'
            && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.transferenciaId)).data.entregas.size() == get(/databases/$(database)/documents/rutas/$(request.resource.data.transferenciaId)).data.entregas.size() + 1)
          || (request.resource.data.origen == 'venta_medidor'
            && request.resource.data.tipoVenta == 'venta_medidor'
            && request.resource.data.unidadOperativaTipo == 'vehiculo'
            && request.resource.data.jornadaId is string
            && request.resource.data.vehiculoId is string
            && request.resource.data.medidorId is string
            && (isAdmin() || (isRepartidor()
              && get(/databases/$(database)/documents/vehiculos/$(request.resource.data.vehiculoId)/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid))
            && (
              (request.resource.data.estado == 'confirmada'
                && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.vehiculoId)/jornadas/$(request.resource.data.jornadaId)).data.estado == 'activa'
                && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.vehiculoId)/jornadas/$(request.resource.data.jornadaId)).data.ventasCount == get(/databases/$(database)/documents/vehiculos/$(request.resource.data.vehiculoId)/jornadas/$(request.resource.data.jornadaId)).data.ventasCount + 1)
              || (request.resource.data.estado == 'incidencia_jornada'
                && request.resource.data.requiereRevision == true)
            ))
        );
      allow update, delete: if false;
    }

    // ── historial y movimientos de llenado de planta ──
    match /llenados_planta/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.capturadoPorUid == request.auth.uid);
      allow create: if (isAdmin() || isVendedor())
        && request.resource.data.tipo == 'llenado_produccion'
        && request.resource.data.estado == 'confirmada'
        && request.resource.data.capturadoPorUid == request.auth.uid
        && request.resource.data.plantaId is string
        && request.resource.data.unidadOperativaTipo == 'planta'
        && request.resource.data.lecturaNueva > request.resource.data.lecturaAnterior
        && request.resource.data.cantidadMedida > 0
        && request.resource.data.litrosAplicados == request.resource.data.cantidadMedida
        && request.resource.data.requestId == id
        && request.resource.data.idempotencyKey == id
        && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.plantaId)).data.tipoUnidad == 'planta'
        && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.plantaId)).data.operadorUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /movimientos_agua/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.usuarioUid == request.auth.uid);
      allow create: if (isAdmin() || isVendedor())
        && request.resource.data.tipo == 'salida_produccion'
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad < 0
        && request.resource.data.unidadOperativaTipo == 'planta'
        && request.resource.data.unidadOperativaId is string
        && request.resource.data.usuarioUid == request.auth.uid
        && request.resource.data.requestId is string
        && request.resource.data.idempotencyKey is string
        && request.resource.data.lecturaNueva > request.resource.data.lecturaAnterior
        && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.origenId)).data.tipo == 'llenado_produccion'
        && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.origenId)).data.capturadoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── movimientos derivados de planta ──
    // Se crean dentro de la misma transacción que la nota y el descuento de stock.
    // Son inmutables y deben conservar el mismo requestId de la operación original.
    match /operaciones_planta/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.capturadoPorUid == request.auth.uid);
      allow create: if (isAdmin() || isVendedor())
        && request.resource.data.capturadoPorUid == request.auth.uid
        && request.resource.data.tipo in ['venta_producto_planta', 'llenado_produccion']
        && request.resource.data.estado == 'confirmada'
        && request.resource.data.unidadOperativaTipo == 'planta'
        && request.resource.data.unidadOperativaId is string
        && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.tipoUnidad == 'planta'
        && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.operadorUid == request.auth.uid)
                && request.resource.data.requestId == request.resource.data.idempotencyKey;
      allow update, delete: if false;
    }
    match /movimientos_inventario/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.capturadoPorUid == request.auth.uid);
      allow create: if (isAdmin() || isVendedor())
        && request.resource.data.capturadoPorUid == request.auth.uid
        && request.resource.data.tipo in ['salida_venta', 'salida_produccion', 'entrada_produccion']
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad > 0
        && request.resource.data.unidadOperativaTipo == 'planta'
        && request.resource.data.unidadOperativaId is string
        && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.tipoUnidad == 'planta'
        && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.operadorUid == request.auth.uid)
        && request.resource.data.requestId is string
        && request.resource.data.idempotencyKey is string;
      allow update, delete: if false;
    }

    match /movimientos_caja/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.capturadoPorUid == request.auth.uid);
      allow create: if (isAdmin() || isVendedor())
        && request.resource.data.capturadoPorUid == request.auth.uid
        && request.resource.data.tipo in ['venta_efectivo', 'venta_no_efectivo']
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.unidadOperativaTipo == 'planta'
        && request.resource.data.unidadOperativaId is string
        && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.tipoUnidad == 'planta'
        && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.operadorUid == request.auth.uid)
        && request.resource.data.requestId == request.resource.data.idempotencyKey;
      allow update, delete: if false;
    }

    match /movimientos_cxc/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.capturadoPorUid == request.auth.uid);
      allow create: if (isAdmin() || isVendedor())
        && request.resource.data.capturadoPorUid == request.auth.uid
        && request.resource.data.tipo == 'venta_credito'
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.unidadOperativaId is string
        && getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.tipoUnidad == 'planta'
        && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(request.resource.data.unidadOperativaId)).data.operadorUid == request.auth.uid)
        && request.resource.data.requestId == request.resource.data.idempotencyKey;
      allow update, delete: if false;
    }

    // ── creditos ──
    match /creditos/{id} {
      allow read: if puedeCobrarCredito(resource.data);
      allow create: if isAdmin()
        || ((isVendedor() || isRepartidor())
          && request.resource.data.capturadoPorUid == request.auth.uid
          && request.resource.data.cobradorUids is list
          && request.auth.uid in request.resource.data.cobradorUids);
      // El saldo y el estado solo cambian al aprobar un abono pendiente.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'saldo', 'estado', 'ultimoAbonoAprobadoId', 'fechaLiquidacion'
        ]);
      allow delete: if false;

      match /abonos/{abonoId} {
        allow read: if puedeCobrarCredito(get(/databases/$(database)/documents/creditos/$(id)).data);
        allow create: if puedeCobrarCredito(get(/databases/$(database)/documents/creditos/$(id)).data)
          && request.resource.data.capturadoPorUid == request.auth.uid
          && request.resource.data.monto is number
          && request.resource.data.monto > 0
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.formaPago in ['efectivo', 'transferencia'];
        allow update: if isAdmin()
          && resource.data.estado == 'pendiente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'aprobadoPorUid', 'aprobadoPorNombre', 'fechaAprobacion', 'motivoRechazo'
          ])
          && request.resource.data.estado in ['aprobado', 'rechazado']
          && (request.resource.data.estado == 'aprobado'
            || (request.resource.data.motivoRechazo is string && request.resource.data.motivoRechazo.size() > 0));
        allow delete: if false;
      }
    }

    // ── pedidos ──
    match /pedidos/{id} {
      allow read: if isAdmin()
        || (isRepartidor() && resource.data.repartidorId == request.auth.uid);

      // Oficina crea borradores. Administración asigna pedidos a terceros.
      // El repartidor crea únicamente pedidos asignados a sí mismo.
      allow create: if (
          (isAdmin() && request.resource.data.creadoPorUid == request.auth.uid)
          || (isRepartidor()
            && request.resource.data.creadoPorUid == request.auth.uid
            && request.resource.data.repartidorId == request.auth.uid
            && request.resource.data.estado == 'asignado_pendiente_transferencia')
        );

      allow update: if isAdmin()
        || (isRepartidor()
          && resource.data.repartidorId == request.auth.uid
          && request.resource.data.repartidorId == request.auth.uid
          && resource.data.estado == 'asignado_pendiente_transferencia'
          && request.resource.data.estado == 'transferencia_confirmada'
          && request.resource.data.transferenciaId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'transferenciaId', 'fechaConfirmacionTransferencia',
            'confirmadaPorUid', 'confirmadaPorNombre', 'fechaActualizacion'
          ])
          && request.resource.data.confirmadaPorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.transferenciaId)).data.repartidorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/rutas/$(request.resource.data.transferenciaId)).data.estado == 'activa')
        || (isRepartidor()
          && resource.data.repartidorId == request.auth.uid
          && request.resource.data.repartidorId == request.auth.uid
          && resource.data.estado == 'transferencia_confirmada'
          && request.resource.data.estado == 'entregado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'notaId', 'fechaEntrega', 'entregadoPorUid',
            'entregadoPorNombre', 'fechaActualizacion', 'requiereRevision'
          ])
          && request.resource.data.entregadoPorUid == request.auth.uid);

      allow delete: if false;
    }

    // ── rutas ──
    // La colección mantiene transferencias desde almacén. El repartidor puede
    // crear solo una transferencia propia y operar únicamente sus documentos.
    match /rutas/{id} {
      allow read: if isAdmin()
        || (isRepartidor() && resource.data.repartidorId == request.auth.uid);
      allow create: if isAdmin()
        || (isRepartidor()
          && request.resource.data.repartidorId == request.auth.uid
          && request.resource.data.asignadaPorUid == request.auth.uid
          && request.resource.data.tipo == 'transferencia_almacen'
          && request.resource.data.origen == 'almacen'
          && request.resource.data.estado == 'activa'
          && request.resource.data.items.size() > 0);
      allow update: if isAdmin()
        || (isRepartidor()
          && resource.data.repartidorId == request.auth.uid
          && request.resource.data.repartidorId == request.auth.uid
          && (
            // Mientras está abierta, el responsable solo registra una venta.
            (resource.data.estado == 'activa'
              && request.resource.data.estado == 'activa'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'entregas'])
              && request.resource.data.entregas.size() == resource.data.entregas.size() + 1)
            // Al terminar, únicamente solicita que almacén reciba y concilie.
            || (resource.data.estado == 'activa'
              && request.resource.data.estado == 'pendiente_recepcion'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'estado', 'estadoTransferencia', 'fechaSolicitudCierre',
                'solicitadoPorUid', 'solicitadoPorNombre'
              ])
              && request.resource.data.solicitadoPorUid == request.auth.uid)
          ));
      allow delete: if false;
    }

    // ── devoluciones (usado por rutas-repartidores.js, panel de admin/repartidor) ──
    match /devoluciones/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isRepartidor()
          && request.resource.data.capturadoPorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── gastos (Gerencia: salidas de efectivo/tarjeta) ──
    // Cualquiera crea, siempre y cuando capturadoPorUid sea su propio uid.
    // Cada quien lee solo lo suyo; admin lee todo. Solo admin edita/elimina.
    match /gastos/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.capturadoPorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.capturadoPorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Comprobantes de cierre de caja — inmutables una vez creados (nadie
    // "corrige" un cierre, se genera uno nuevo si algo cambió).
    match /cierres_caja/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.capturadoPorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.capturadoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── usuarios (perfiles) ──
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Los perfiles no se autocrean desde la PWA. El alta debe venir de un
      // flujo administrativo autorizado o de una operación controlada de backend.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /cajas_jornada/{cajaId} {
      allow read: if isAdmin() || (puedeUsarCaja() && cajaPropia(resource.data));
      allow create: if puedeUsarCaja()
        && ((isRepartidor() && request.resource.data.repartidorId == request.auth.uid)
          || (isVendedor() && request.resource.data.operadorUid == request.auth.uid))
        && request.resource.data.estado == 'abierta';
      allow update: if puedeUsarCaja()
        && cajaPropia(resource.data)
        && resource.data.estado == 'abierta'
        && request.resource.data.estado == 'cerrada';
      allow delete: if false;
    }

    // ── vehículos y medidores fijos ──
    match /vehiculos/{vehiculoId} {
      allow read: if isAdmin()
        || (isRepartidor() && resource.data.repartidorIds is list && request.auth.uid in resource.data.repartidorIds)
        || (isVendedor() && resource.data.tipoUnidad == 'planta' && resource.data.operadorUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isRepartidor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'jornadaActivaId', 'medidorUltimaLectura', 'actualizadoEn'
          ])
          && (
            (request.resource.data.jornadaActivaId is string
              && request.resource.data.jornadaActivaId != ''
              && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(request.resource.data.jornadaActivaId)).data.repartidorId == request.auth.uid
              && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(request.resource.data.jornadaActivaId)).data.estado == 'activa')
            || (request.resource.data.jornadaActivaId == ''
              && resource.data.jornadaActivaId is string
              && resource.data.jornadaActivaId != ''
              && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(resource.data.jornadaActivaId)).data.estado == 'cerrada')
          ))
        || (isVendedor()
          && resource.data.tipoUnidad == 'planta'
          && resource.data.operadorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'medidorUltimaLectura', 'actualizadoEn', 'ultimaProduccionId'
          ])
          && request.resource.data.ultimaProduccionId is string
          && request.resource.data.medidorUltimaLectura is number
          && request.resource.data.medidorUltimaLectura > resource.data.medidorUltimaLectura
          && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.ultimaProduccionId)).data.tipo == 'llenado_produccion'
          && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.ultimaProduccionId)).data.capturadoPorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/operaciones_planta/$(request.resource.data.ultimaProduccionId)).data.unidadOperativaId == vehiculoId);
      allow delete: if false;

      match /jornadas/{jornadaId} {
        allow read: if jornadaPropia(resource.data);
        allow create: if signedIn()
          && (isAdmin()
            || (isRepartidor() && request.resource.data.repartidorId == request.auth.uid)
            || (isVendedor() && request.resource.data.operadorUid == request.auth.uid
              && request.resource.data.unidadOperativaTipo == 'planta'))
          && request.resource.data.vehiculoId == vehiculoId
          && request.resource.data.medidorId is string
          && request.resource.data.lecturaInicial >= 0
          && request.resource.data.lecturaCierreAnterior >= 0
          && request.resource.data.lecturaInicial > request.resource.data.lecturaCierreAnterior
          && request.resource.data.cantidadPorDigito > 0
          && request.resource.data.unidadMedida is string
          && request.resource.data.tipoFlujoMedidor == 'volumen_acumulado';
        allow update: if signedIn()
          && (isAdmin() || (isRepartidor() && resource.data.repartidorId == request.auth.uid))
          && (
            (resource.data.estado == 'activa'
              && request.resource.data.estado == 'cerrada'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'estado', 'lecturaCierre', 'fechaCierre', 'litrosCalculados', 'cantidadMedidaCalculada', 'cierreId'
              ])
              && request.resource.data.lecturaCierre > (('ultimaLectura' in resource.data) ? resource.data.ultimaLectura : resource.data.lecturaInicial)
              && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.estado == 'cerrada'
              && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaCierre == request.resource.data.lecturaCierre)
            || (resource.data.estado == 'activa'
              && request.resource.data.estado == 'activa'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'ultimaLectura', 'litrosVendidosAcumulados', 'cantidadMedidaVendidaAcumulada', 'ventasCount'
              ])
              && request.resource.data.ultimaLectura > (('ultimaLectura' in resource.data) ? resource.data.ultimaLectura : resource.data.lecturaInicial)
              && request.resource.data.litrosVendidosAcumulados >= resource.data.litrosVendidosAcumulados
              && request.resource.data.cantidadMedidaVendidaAcumulada >= (('cantidadMedidaVendidaAcumulada' in resource.data) ? resource.data.cantidadMedidaVendidaAcumulada : 0)
              && request.resource.data.ventasCount == resource.data.ventasCount + 1)
          );
        allow delete: if false;

        match /lecturas/{lecturaId} {
          allow read: if jornadaVisible(vehiculoId, jornadaId);
          allow create: if signedIn()
            && request.resource.data.jornadaId == jornadaId
            && request.resource.data.vehiculoId == vehiculoId
            && request.resource.data.lectura >= 0
            && (isAdmin()
              || request.resource.data.creadoPorUid == request.auth.uid
              || request.resource.data.capturadoPorUid == request.auth.uid
              || request.resource.data.cerradoPorUid == request.auth.uid)
            && (
              (request.resource.data.tipo == 'inicio_jornada'
                && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaInicial == request.resource.data.lectura)
              || (request.resource.data.tipo == 'venta'
                && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.repartidorId == request.auth.uid)
                && request.resource.data.lectura > (('ultimaLectura' in get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data) ? get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.ultimaLectura : get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaInicial)
                && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.ultimaLectura == request.resource.data.lectura)
              || (request.resource.data.tipo == 'cierre_jornada'
                && (isAdmin() || getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.repartidorId == request.auth.uid)
                && request.resource.data.lectura > (('ultimaLectura' in get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data) ? get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.ultimaLectura : get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaInicial)
                && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaCierre == request.resource.data.lectura)
            );
          allow update, delete: if false;
        }
        match /recargas/{recargaId} {
          allow read: if jornadaVisible(vehiculoId, jornadaId);
          allow create: if jornadaVisible(vehiculoId, jornadaId)
            && request.resource.data.jornadaId == jornadaId
            && request.resource.data.vehiculoId == vehiculoId
            && request.resource.data.cantidadMedida > 0
            && request.resource.data.unidadMedida is string
            && (isAdmin() || request.resource.data.capturadoPorUid == request.auth.uid);
          allow update, delete: if false;
        }
        match /ventas/{ventaId} {
          allow read: if jornadaVisible(vehiculoId, jornadaId);
          allow create: if jornadaVisible(vehiculoId, jornadaId)
            && request.resource.data.jornadaId == jornadaId
            && request.resource.data.vehiculoId == vehiculoId
            && request.resource.data.medidorId is string
            && request.resource.data.cierreCajaId is string
            && request.resource.data.lecturaFinal > request.resource.data.lecturaInicial
            && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.estado == 'activa'
            && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.ultimaLectura == request.resource.data.lecturaFinal
            && request.resource.data.lecturaFinal > (('ultimaLectura' in get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data) ? get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.ultimaLectura : get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaInicial)
            && request.resource.data.cantidadMedida > 0
            && request.resource.data.unidadMedida is string
            && request.resource.data.precioPorUnidad > 0
            && request.resource.data.subtotal >= 0
            && (isAdmin() || request.resource.data.capturadoPorUid == request.auth.uid);
          allow update, delete: if false;
        }
        match /cierres/{cierreId} {
          allow read: if jornadaVisible(vehiculoId, jornadaId);
          allow create: if jornadaVisible(vehiculoId, jornadaId)
            && request.resource.data.jornadaId == jornadaId
            && request.resource.data.vehiculoId == vehiculoId
            && request.resource.data.lecturaCierre > request.resource.data.lecturaInicial
            && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.estado == 'cerrada'
            && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaCierre == request.resource.data.lecturaCierre
            && request.resource.data.lecturaCierre > (('ultimaLectura' in get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data) ? get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.ultimaLectura : get(/databases/$(database)/documents/vehiculos/$(vehiculoId)/jornadas/$(jornadaId)).data.lecturaInicial)
            && request.resource.data.cantidadMedida >= 0
            && request.resource.data.unidadMedida is string
            && (isAdmin() || request.resource.data.cerradoPorUid == request.auth.uid);
          allow update, delete: if false;
        }
        match /incidencias/{incidenciaId} {
          allow read: if jornadaVisible(vehiculoId, jornadaId);
          allow create: if jornadaVisible(vehiculoId, jornadaId)
            && request.resource.data.jornadaId == jornadaId
            && request.resource.data.vehiculoId == vehiculoId
            && request.resource.data.motivo is string
            && request.resource.data.motivo.size() > 0
            && (isAdmin() || request.resource.data.capturadoPorUid == request.auth.uid);
          allow update, delete: if false;
        }
      }
    }

    match /medidores/{medidorId} {
      allow read: if isAdmin()
        || (isRepartidor() && resource.data.vehiculoId is string)
        || (isVendedor() && resource.data.tipo == 'planta' && resource.data.operadorUid == request.auth.uid);
      allow create, update: if isAdmin() && medidorConfigValida(request.resource.data);
      allow delete: if false;
    }

    // ── precios por unidad del medidor; la colección antigua queda solo para compatibilidad ──
    match /tarifas_agua/{tarifaId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && ((request.resource.data.precioPorUnidad is number && request.resource.data.precioPorUnidad > 0 && request.resource.data.unidadMedida is string)
          || (request.resource.data.precioPorGarrafon is number && request.resource.data.precioPorGarrafon > 0 && request.resource.data.litrosPorGarrafon > 0));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── catálogo de rutas y clientes configurables ──
    match /localidades_catalogo/{localidadId} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /rutas_catalogo/{rutaId} {
      allow read: if isAdmin() || (signedIn() && resource.data.repartidorId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.clienteIds is list
        && request.resource.data.localidadId is string
        && request.resource.data.repartidorId is string
        && request.resource.data.repartidorId.size() > 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /carteras_repartidores/{repartidorId}/clientes/{clienteId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == repartidorId);
      allow create: if signedIn() && request.auth.uid == repartidorId && isRepartidor()
        && request.resource.data.clienteId == clienteId
        && request.resource.data.repartidorId == repartidorId
        && request.resource.data.rutaId is string
        && get(/databases/$(database)/documents/rutas_catalogo/$(request.resource.data.rutaId)).data.repartidorId == repartidorId;
      allow update, delete: if false;
    }

    match /solicitudes_desactivacion_clientes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.repartidorId == request.auth.uid);
      allow create: if isRepartidor()
        && request.resource.data.repartidorId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.envaseDevuelto == true
        && request.resource.data.baseDevuelta == true
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0;
      allow update: if isAdmin()
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['autorizada', 'rechazada']
        && (request.resource.data.estado == 'autorizada'
          || (request.resource.data.motivoRechazo is string && request.resource.data.motivoRechazo.size() > 0));
      allow delete: if false;
    }

    // ── _meta (control interno de sembrado de datos) ──
    // La PWA puede leer el estado interno de datos de ejemplo; la escritura
    // permanece restringida a administración. El cliente no crea perfiles.
    
    match /_meta/branding {
      // El documento solo contiene identidad comercial no sensible.
      allow read: if true;
      allow create, update: if isAdmin() && brandingValida(request.resource.data);
      allow delete: if false;
    }

    match /_meta/system_setup {
      // Solo se puede completar una vez desde la PWA por el primer admin.
      allow read: if signedIn();
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/_meta/system_setup)
        && setupProyectoValido(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /_meta/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && id != 'branding' && id != 'system_setup';
    }

    // ── Todo lo demás: denegado por defecto ──
    // Nunca debería activarse en operación normal — es un backstop de
    // seguridad, no una regla "viva". Si alguna vez una acción legítima
    // termina cayendo aquí, es señal de que falta agregar esa colección
    // arriba, en la lista de "Cobertura de colecciones".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
